<script>
'use strict';

const RATES = {
  pension: 0.0475, pensionMaxBase: 6590000,
  health: 0.03595, care: 0.1314, employment: 0.009
};

const $ = id => document.getElementById(id);
const fmt = n => Math.round(n).toLocaleString('ko-KR');
const toNum = el => Number((el.value || '0').replace(/[^\d]/g, ''));

let mode = 'annual';

document.querySelectorAll('.toggle-tab').forEach(tab => {
  tab.addEventListener('click', () => {
    mode = tab.dataset.mode;
    document.querySelectorAll('.toggle-tab').forEach(t => t.classList.toggle('active', t === tab));
    $('amount-label').textContent = mode === 'annual' ? '연봉 (퇴직금 별도)' : '월급 (세전)';
    $('amount').placeholder = mode === 'annual' ? '예: 5000' : '예: 400';
    calc();
  });
});

function calcIncomeTax(annualTaxable, dependents, children) {
  let earned;
  if (annualTaxable <= 5000000) earned = annualTaxable * 0.7;
  else if (annualTaxable <= 15000000) earned = 3500000 + (annualTaxable - 5000000) * 0.4;
  else if (annualTaxable <= 45000000) earned = 7500000 + (annualTaxable - 15000000) * 0.15;
  else if (annualTaxable <= 100000000) earned = 12000000 + (annualTaxable - 45000000) * 0.05;
  else earned = 14750000 + (annualTaxable - 100000000) * 0.02;
  earned = Math.min(earned, 20000000);
  const personal = dependents * 1500000;
  const taxBase = Math.max(0, annualTaxable - earned - personal);
  let tax;
  if (taxBase <= 14000000) tax = taxBase * 0.06;
  else if (taxBase <= 50000000) tax = 840000 + (taxBase - 14000000) * 0.15;
  else if (taxBase <= 88000000) tax = 6240000 + (taxBase - 50000000) * 0.24;
  else if (taxBase <= 150000000) tax = 15360000 + (taxBase - 88000000) * 0.35;
  else if (taxBase <= 300000000) tax = 37060000 + (taxBase - 150000000) * 0.38;
  else if (taxBase <= 500000000) tax = 94060000 + (taxBase - 300000000) * 0.40;
  else if (taxBase <= 1000000000) tax = 174060000 + (taxBase - 500000000) * 0.42;
  else tax = 384060000 + (taxBase - 1000000000) * 0.45;
  let credit = tax <= 1300000 ? tax * 0.55 : 715000 + (tax - 1300000) * 0.30;
  const cap = annualTaxable <= 33000000 ? 740000
    : annualTaxable <= 70000000 ? Math.max(660000, 740000 - (annualTaxable - 33000000) * 0.008)
    : annualTaxable <= 120000000 ? Math.max(500000, 660000 - (annualTaxable - 70000000) * 0.005)
    : Math.max(200000, 500000 - (annualTaxable - 120000000) * 0.005);
  credit = Math.min(credit, cap);
  let childCredit = 0;
  if (children >= 1) childCredit += 250000;
  if (children >= 2) childCredit += 250000;
  if (children >= 3) childCredit += (children - 2) * 350000;
  return Math.max(0, tax - credit - childCredit);
}

function calc() {
  const amount = toNum($('amount'));
  const annualSalary = mode === 'annual' ? amount * 10000 : amount * 10000 * 12;
  const dependents = parseInt($('dependents').value);
  const children = parseInt($('children').value);
  const monthlyNontax = toNum($('nontax'));

  if (annualSalary === 0) {
    $('net-amount').innerHTML = '0<span class="won">원</span>';
    $('result-sub').textContent = mode === 'annual' ? '연봉을 입력하면 즉시 계산됩니다' : '월급을 입력하면 즉시 계산됩니다';
    ['d-pension','d-health','d-care','d-employment','d-income-tax','d-local-tax','d-total'].forEach(id => $(id).textContent = '0원');
    return;
  }

  const monthlyGross = annualSalary / 12;
  const monthlyTaxable = Math.max(0, monthlyGross - monthlyNontax);
  const annualTaxable = monthlyTaxable * 12;
  const pensionBase = Math.min(monthlyTaxable, RATES.pensionMaxBase);
  const pension = pensionBase * RATES.pension;
  const health = monthlyTaxable * RATES.health;
  const care = health * RATES.care;
  const employment = monthlyTaxable * RATES.employment;
  const incomeTax = calcIncomeTax(annualTaxable, dependents, children) / 12;
  const localTax = incomeTax * 0.1;
  const total = pension + health + care + employment + incomeTax + localTax;
  const net = monthlyGross - total;

  $('net-amount').innerHTML = fmt(net) + '<span class="won">원</span>';
  $('result-sub').textContent = `세전 ${fmt(monthlyGross)}원 · 공제 ${fmt(total)}원 · 실수령률 ${((net/monthlyGross)*100).toFixed(1)}%`;

  $('d-pension').textContent = fmt(pension) + '원';
  $('d-health').textContent = fmt(health) + '원';
  $('d-care').textContent = fmt(care) + '원';
  $('d-employment').textContent = fmt(employment) + '원';
  $('d-income-tax').textContent = fmt(incomeTax) + '원';
  $('d-local-tax').textContent = fmt(localTax) + '원';
  $('d-total').textContent = fmt(total) + '원';
}

function attachInputFormat(el) {
  el.addEventListener('input', e => {
    const raw = e.target.value.replace(/[^\d]/g, '');
    e.target.value = raw ? Number(raw).toLocaleString('ko-KR') : '';
    calc();
  });
}
attachInputFormat($('amount'));
attachInputFormat($('nontax'));
$('dependents').addEventListener('change', calc);
$('children').addEventListener('change', calc);

// Default
$('amount').value = '5,000';
calc();
</script>

<script>
(function(){
  if('serviceWorker' in navigator){
    window.addEventListener('load', function(){
      navigator.serviceWorker.register('/sw.js').catch(function(){});
    });
  }
  var deferredPrompt = null;
  var btn = document.createElement('button');
  btn.id = 'pwa-install-btn';
  btn.style.cssText = 'display:none;position:fixed;bottom:20px;right:20px;z-index:200;background:#D94A1F;color:white;border:none;padding:14px 22px;border-radius:100px;font-family:Pretendard,sans-serif;font-size:14px;font-weight:700;cursor:pointer;box-shadow:0 8px 24px rgba(217,74,31,.35);align-items:center;gap:8px;';
  btn.innerHTML = decodeURIComponent('%E2%AC%87%20%EC%95%B1%EC%9C%BC%EB%A1%9C%20%EC%84%A4%EC%B9%98');
  document.body.appendChild(btn);

  var iosBtn = document.createElement('button');
  iosBtn.id = 'pwa-ios-btn';
  iosBtn.style.cssText = 'display:none;position:fixed;bottom:20px;right:20px;z-index:200;background:#D94A1F;color:white;border:none;padding:14px 22px;border-radius:100px;font-family:Pretendard,sans-serif;font-size:14px;font-weight:700;cursor:pointer;box-shadow:0 8px 24px rgba(217,74,31,.35);align-items:center;gap:8px;';
  iosBtn.innerHTML = decodeURIComponent('%F0%9F%93%B1%20%ED%99%88%20%ED%99%94%EB%A9%B4%EC%97%90%20%EC%B6%94%EA%B0%80');
  document.body.appendChild(iosBtn);

  window.addEventListener('beforeinstallprompt', function(e){
    e.preventDefault();
    deferredPrompt = e;
    btn.style.display = 'inline-flex';
  });

  btn.addEventListener('click', async function(){
    if(!deferredPrompt) return;
    deferredPrompt.prompt();
    var c = await deferredPrompt.userChoice;
    if(c.outcome === 'accepted') btn.style.display = 'none';
    deferredPrompt = null;
  });

  window.addEventListener('appinstalled', function(){ btn.style.display = 'none'; iosBtn.style.display = 'none'; });
  if(window.matchMedia('(display-mode: standalone)').matches){ btn.style.display = 'none'; iosBtn.style.display = 'none'; }

  // iOS detection
  var isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent) && !window.MSStream;
  var isStandalone = window.navigator.standalone === true;
  if(isIOS && !isStandalone){
    iosBtn.style.display = 'inline-flex';
    iosBtn.addEventListener('click', function(){
      var msg = decodeURIComponent('%EC%83%81%EB%8B%A8%20%EA%B3%B5%EC%9C%A0%20%EB%B2%84%ED%8A%BC%20%E2%86%92%20%5B%ED%99%88%20%ED%99%94%EB%A9%B4%EC%97%90%20%EC%B6%94%EA%B0%80%5D%20%EC%84%A0%ED%83%9D%ED%95%98%EC%84%B8%EC%9A%94');
      alert(msg);
    });
  }
})();
</script>
</body>
</html>
